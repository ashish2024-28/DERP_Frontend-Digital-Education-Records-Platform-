VITE_API_BASE_URL=xxxxxxxxxx-production.up.railway.app
VITE_API_BASE_URL=xxxxxxxxxx-production.up.railway.app
VITE_API_BASE_URL=http://localhost:8080


# How Vite knows which one to use

# When you run:

# npm run dev -- --host

# Vite runs in development mode:

# .env.development
#        ↓
# http://172.168.22.34:8080

# So:

# PC browser
# http://localhost:5173
#         ↓
# Spring Boot
# http://172.168.22.34:8080

# And phone:

# Phone
# http://172.168.22.34:5173
#         ↓
# Spring Boot
# http://172.168.22.34:8080
# When you build production
# npm run build

# Vite uses:

# .env.production

# Therefore:

# React
#    ↓
# https://derp-backend-production.up.railway.app

# and OTP:

# React
#    ↓
# https://otp-service-fcxh.onrender.com
# Even better: define scripts

# Your package.json can have:

# {
#   "scripts": {
#     "dev": "vite",
#     "build": "vite build",
#     "preview": "vite preview"
#   }
# }

# Then:

# Local development
# npm run dev -- --host

# Uses:

# .env.development
# Production build
# npm run build

# Uses:

# .env.production